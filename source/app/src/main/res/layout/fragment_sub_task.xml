<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="f"
            type="graduate.itdreams.android.ui.main.taskdetail.SubTaskFragment"/>
        <variable
            name="vm"
            type="graduate.itdreams.android.ui.main.taskdetail.SubTaskViewModel"/>

        <import type="android.view.View"/>
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_5sdp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_30sdp"
            android:text="@{vm.subTaskDetail.title}"
            android:paddingBottom="@dimen/_10sdp"
            style="@style/Text_24_Bold_Black"
            android:layout_gravity="center"/>
        <TextView
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{vm.subTaskDetail.description}"
            style="@style/Text_12_Normal_Black"
            android:layout_gravity="center"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            />
        <LinearLayout
            android:id="@+id/documentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="@dimen/_10sdp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài liệu"
                style="@style/Text_16_Bold_Black"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_pdf"
                android:onClick="@{v->f.viewFileClick()}"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutQuestionFileAndText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5sdp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvQuestionFileAndText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                />
        </LinearLayout>


    </LinearLayout>


</layout>